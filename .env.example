# Copy to .env.local (web) and .env (worker/prisma). Never commit real values.

# --- Core ---
DATABASE_URL=postgresql://sm:sm@localhost:5432/social_manager?schema=public
DIRECT_URL=postgresql://sm:sm@localhost:5432/social_manager?schema=public
PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=change-me-32-bytes-base64
TOKEN_ENCRYPTION_KEY=change-me-32-bytes-base64   # openssl rand -base64 32
CRON_SECRET=change-me                            # protects /api/jobs/tick on serverless hosts
DEFAULT_TIMEZONE=Europe/Rome
DEFAULT_LOCALE=it

# --- Owner bootstrap (used by `pnpm db:seed`; the password is hashed, never stored in clear) ---
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=choose-a-long-password
OWNER_NAME=Owner

# --- Media storage: local | s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/media
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=social-media
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_FORCE_PATH_STYLE=true

# --- Optional provider apps (native adapters). Leave empty until registered. ---
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional Zernio gateway (can also be saved encrypted from Settings in the app) ---
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=

# --- Optional AI (OpenRouter-compatible) ---
AI_API_BASE=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4.5
